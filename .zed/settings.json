              "java.util.Collections.*",
              "java.util.stream.Collectors.*",
            ],
            // 3. Thứ tự tự động import (java.* luôn ở trên cùng)
            "importOrder": ["java", "javax", "jakarta", "org", "com", "#"],
          },
        },
      },
    },
